# YAIFM - ESPHome Secrets Template
# Kopiere diese Datei nach secrets.yaml und trage deine Werte ein.
# secrets.yaml wird NICHT nach GitHub gepusht (.gitignore).

# WLAN
wifi_ssid: "DEIN_WLAN_NAME"
wifi_password: "DEIN_WLAN_PASSWORT"

# ESPHome API Verschlüsselung (32 Byte Base64)
# Generieren: esphome generate-key
api_encryption_key: "GENERIERTE_KEY_HIER_EINTRAGEN"

# OTA Passwort
ota_password: "DEIN_OTA_PASSWORT"

# Fallback Hotspot (wenn WLAN nicht erreichbar)
fallback_ap_password: "GENERIERTE_PASSWORT_HIER_EINTRAGEN"